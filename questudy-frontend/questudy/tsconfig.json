{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "web", "outDir": "web/dist", "noEmitOnError": true,
    "strict": true, "strictNullChecks": false, "useUnknownInCatchVariables": false, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["web/**/*.ts"], "exclude": ["web/vendor", "web/dist"]
}
